# Copy to .env and fill in. This file is read by the Node server only;
# nothing here is sent to the browser.

# Any OpenAI-compatible endpoint works.
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Used for document Q&A. For Ollama try: nomic-embed-text
EMBED_MODEL=text-embedding-3-small

# Optional: comma-separated list to restrict which models clients can use.
# Recommended if you deploy this publicly, otherwise anyone can pick the most expensive model.
ALLOWED_MODELS=

PORT=8787
