{
  "name": "ai-chat-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Streaming LLM chat client with document Q&A (RAG), works with OpenAI or any OpenAI-compatible API including local Ollama",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "bench": "node scripts/bench.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^13.0.3",
    "marked-highlight": "^2.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "author": "Aranya Ghosh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aranya2801/AI-Chat-Bot.git"
  }
}
